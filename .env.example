# Database (PostgreSQL / Neon). Leave empty to run without DB (e.g. serverless cold start).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Required for JWT signing. Use a long random string in production (at least 32 chars).
JWT_SECRET=your-secret-at-least-32-chars

# Server port (default 3000)
PORT=3000

# development | production
NODE_ENV=development

# Optional. Vercel Blob read-write token. When set (e.g. on Vercel), profile avatars are stored in Blob
# so they persist across serverless invocations. Without it, avatars are stored on disk (local) or tmp (serverless, not persistent).
# BLOB_READ_WRITE_TOKEN=

# Optional. Comma-separated list of allowed CORS origins. If unset, defaults include
# https://app.leasepilotai.com and http://localhost:3000
# ALLOWED_ORIGINS=https://app.leasepilotai.com,http://localhost:3000

# Demo mode — set to 'true' to enable the /api/auth/demo endpoint (disabled by default in production)
# ENABLE_DEMO=false

# Demo account password (only used when ENABLE_DEMO=true, overrides the default)
# DEMO_PASSWORD=ChangeMe123!

# Twilio SMS (optional). Get from https://console.twilio.com
# You must have a Twilio phone number (Phone Numbers > Manage > Buy a number) to send SMS.
# Trial accounts can only send to verified numbers: add them at https://twilio.com/user/account/phone-numbers/verified
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1234567890
